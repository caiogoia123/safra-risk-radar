# Raw and staged data, plus the DuckDB file (regenerate with: python -m ingestion).
# Anchored to the repo root on purpose: an unanchored `data/` also matches
# app/data/, which holds the small CSVs the published dashboard reads and which
# must be committed.
/data/

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/
logs/
.user.yml

# Credentials - NEVER commit
*.json.key
service-account*.json
.env
.env.*
!.env.example

# OS / editors
Thumbs.db
.DS_Store
.vscode/
.idea/
# Local tooling: launch config points at this machine's .venv, and worktrees are
# scratch checkouts.
.claude/
