# Copy to .env and fill in. Never commit the real .env (it is gitignored).
#
# PowerShell, current session only:
#   $env:GCP_KEYFILE = "C:\Users\<user>\.gcp\safra-risk-radar.json"
#   $env:GCP_PROJECT = "safra-risk-radar"

GCP_KEYFILE=C:\path\to\your\service-account.json
GCP_PROJECT=safra-risk-radar
